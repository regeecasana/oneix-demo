# Live sync between the customer demo (/) and the Agent Workspace (/agent).
#
# On Vercel: Storage / Marketplace -> add "Upstash Redis" to the project. It injects
# these automatically (KV_REST_API_URL / KV_REST_API_TOKEN work as well).
# Locally you can leave both unset: an in-memory relay works on a single dev server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
