# Live sync between the customer demo (/) and the Agent Workspace (/agent).
#
# On Vercel: Storage / Marketplace -> add "Upstash Redis" to the project. It injects
# these automatically (KV_REST_API_URL / KV_REST_API_TOKEN work as well).
# Locally you can leave both unset: an in-memory relay works on a single dev server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Passcode required to open /agent (see middleware.ts + app/agent-gate). The
# public demo at / is unaffected. Leave unset and /agent-gate can never be
# unlocked -- it fails closed, not open.
AGENT_PASSCODE=

# Powers the live agent's co-pilot reply suggestion (see
# app/api/suggest-reply). Leave unset and the composer just starts blank --
# no suggestion, no error shown to the agent.
OPENAI_API_KEY=
# Optional -- defaults to gpt-4o-mini.
OPENAI_MODEL=
